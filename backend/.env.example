# Copy this file to .env for local development
# On Railway, set these as environment variables in the dashboard

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_strong_random_secret
JWT_EXPIRE_DAYS=7

GROQ_API_KEY=your_groq_api_key

# On Railway: set to your frontend Railway URL
# e.g. https://homeval-frontend-production.up.railway.app
ALLOWED_ORIGINS_RAW=http://localhost:3000

ML_MODEL_PATH=ml/housing_model.pkl
